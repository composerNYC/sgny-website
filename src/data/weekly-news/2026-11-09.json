  "html": "<table role=\"presentation\" width=\"600\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" class=\"wn-mail\" style=\"width:100%;max-width:600px;margin:0 auto;border-radius:16px;overflow:hidden;border:1px solid #e7e2d8;\">\n<tr><td class=\"pad\" style=\"background:#fbfaf7;padding:36px 40px;\"><div style=\"font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:12px;font-weight:700;letter-spacing:2px;text-transform:uppercase;color:#c08a2d;text-align:left;margin:0 0 8px;\">Happening soon</div><div style=\"font-family:'Iowan Old Style','Palatino Linotype',Palatino,Georgia,serif;font-size:28px;line-height:1.2;font-weight:600;color:#1c2430;text-align:left;margin:0 0 10px;\">Upcoming events</div><div style=\"height:10px;line-height:10px;font-size:0;\">&nbsp;</div><div style=\"margin:0 0 26px;\"><img src=\"https://mcusercontent.com/b68e90a1f6237b2836846604b/images/a408c997-1941-b77d-f9f9-0de1afd37545.jpeg\" alt=\"28th Spiritist Week of the Tri-State: Suicide Prevention, November 15-22, 2026\" width=\"520\" style=\"display:block;width:100%;max-width:520px;height:auto;border:0;border-radius:12px;margin:0 auto;\"><div style=\"font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:14px;line-height:1.55;color:#4a5568;text-align:center;margin:12px 0 0;\"><strong style=\"color:#1c2430;\">28th Spiritist Week of the Tri-State</strong> · November 15–22 · Free admission<br>Talks across NY, NJ and CT. More at <a href=\"https://tssfederation.org\" target=\"_blank\" style=\"color:#1f4e79;text-decoration:underline;\">tssfederation.org</a>.</div></div><div style=\"margin:0 0 26px;\"><img src=\"https://mcusercontent.com/b68e90a1f6237b2836846604b/images/57d7968b-8a8e-7e19-5088-b3f93aaa79f7.jpeg\" alt=\"Program of the 28th Spiritist Week of the Tri-State, November 15-22\" width=\"520\" style=\"display:block;width:100%;max-width:520px;height:auto;border:0;border-radius:12px;margin:0 auto;\"></d