---
import Base from '../../layouts/Base.astro';
import WeeklyIssue from '../../components/WeeklyIssue.astro';
import { latest, subscribeUrl } from '../../lib/weekly-news.js';
---
<Base title="Weekly News" description="This week at the Spiritist Group of New York: upcoming events, new books, the latest videos and the full schedule of free activities.">
  {latest ? <WeeklyIssue issue={latest} isLatest /> : (
    <section class="hero" style="padding-block:clamp(2.5rem,6vw,4rem)">
      <div class="container">
        <p class="eyebrow" style="color:#e9c878">Weekly News</p>
        <h1>Coming soon</h1>
        <p>Our weekly email will appear here every week.</p>
        <div class="actions"><a class="btn btn-primary" href={subscribeUrl} target="_blank" rel="noopener">Get it by email</a></div>
      </div>
    </section>
  )}
</Base>
