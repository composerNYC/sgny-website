---
// Volunteer Prayer Book — embeds the password-protected Apps Script web
// app. This page contains no prayer data itself; the names live behind
// the password screen inside the frame. Kept out of search (noindex +
// sitemap filter in astro.config.mjs).
const BOOK_URL =
  'https://script.google.com/macros/s/AKfycbwWBTla82jL_E1yDe1kpSoJABs-ivnkTrRd_Ac-sBUqyV95Ah6q5s0lm9rP9WXaonBlcg/exec';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Prayer Book · SGNY Volunteers</title>
    <link rel="icon" href="/uploads/2023/04/cropped-logo-SGNY-novo-32x32.jpeg" />
    <style>
      :root {
        --ink: #1c2430;
        --bg: #fbfaf7;
        --line: #e7e2d8;
        --brand: #1f4e79;
        --sans: ui-sans-serif, system-ui, -apple-system, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
      }
      * { box-sizing: border-box; margin: 0; }
      html, body { height: 100%; }
      body { display: flex; flex-direction: column; background: var(--bg); font-family: var(--sans); }
      .bar {
        display: flex; align-items: center; gap: .7rem;
        background: var(--brand); color: #fff; padding: .55rem 1rem;
        font-size: .85rem;
      }
      .bar img { width: 26px; height: 26px; border-radius: 50%; }
      .bar strong { font-weight: 600; }
      .bar a { margin-left: auto; color: #fff; opacity: .85; text-decoration: none; }
      .bar a:hover, .bar a:focus-visible { opacity: 1; text-decoration: underline; }
      iframe { flex: 1; width: 100%; border: 0; }
    </style>
  </head>
  <body>
    <div class="bar">
      <img src="/uploads/2023/04/cropped-logo-SGNY-novo-192x192.jpeg" alt="" width="26" height="26" />
      <strong>SGNY Prayer Book</strong>
      <a href="/">← sgny.org</a>
    </div>
    <iframe src={BOOK_URL} title="SGNY Prayer Book (volunteers)" allow="clipboard-write"></iframe>
  </body>
</html>
